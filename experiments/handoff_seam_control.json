    {"id": "divergent_seam_observed", "trace_outcome": "success", "execution_outcome": "failure", "seam_observed": true, "expected_state": "deny_divergence"},
    {"id": "divergent_seam_missing", "trace_outcome": "success", "execution_outcome": "failure", "seam_observed": false, "expected_state": "deny_divergence"},
    {"id": "trace_missing_seam_observed", "trace_outcome": "unknown", "execution_outcome": "success", "seam_observed": true, "expected_state": "deny_missing_trace"},
    {"id": "execution_missing_seam_observed", "trace_outcome": "success", "execution_outcome": "unknown", "seam_observed": true, "expected_state": "deny_missing_execution"},
    {"id": "both_unknown_seam_missing", "trace_outcome": "unknown", "execution_outcome": "unknown", "seam_observed": false, "expected_state": "deny_unresolved"}
  ]
