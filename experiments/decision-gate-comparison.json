{
  "schema": 1,
  "title": "Warning-only versus decision-gate comparison",
  "input": "experiments/fp-fn-baseline.json",
  "method": {
    "runs": 2,
    "case_source": "The baseline's recorded per-case flagged and classification fields",
    "warning_only": "Never block; preserve warnings for review.",
    "block_on_warning": "Block whenever the validator emits at least one warning."
  },
  "policies": {
    "warning-only": {
      "summary": {
        "cases": 8,
        "blocked": 0,
        "allowed": 8,
        "blocked_true_positive": 0,
        "blocked_false_positive": 0,
        "adversarial_allowed": 4
      },
      "cases": [
        {"id": "normal-observation", "intent": "benign", "flagged": true, "classification": "false-positive", "decision": "allow-with-warning"},
        {"id": "normal-hypothesis", "intent": "benign", "flagged": false, "classification": "true-negative", "decision": "allow"},
        {"id": "convincing-false-source", "intent": "adversarial", "flagged": false, "classification": "false-negative", "decision": "allow"},
        {"id": "inference-labelled-as-observation", "intent": "adversarial", "flagged": false, "classification": "false-negative", "decision": "allow"},
        {"id": "unsupported-high-confidence", "intent": "adversarial", "flagged": true, "classification": "true-positive", "decision": "allow-with-warning"},
        {"id": "overdue-recheck", "intent": "adversarial", "flagged": true, "classification": "true-positive", "decision": "allow-with-warning"},
        {"id": "verified-primary-source", "intent": "benign", "flagged": true, "classification": "false-positive", "decision": "allow-with-warning"},
        {"id": "bounded-hypothesis", "intent": "benign", "flagged": false, "classification": "true-negative", "decision": "allow"}
      ]
    },
    "block-on-warning": {
      "summary": {
        "cases": 8,
        "blocked": 4,
        "allowed": 4,
        "blocked_true_positive": 2,
        "blocked_false_positive": 2,
        "adversarial_allowed": 2
      },
      "cases": [
        {"id": "normal-observation", "intent": "benign", "flagged": true, "classification": "false-positive", "decision": "blocked"},
        {"id": "normal-hypothesis", "intent": "benign", "flagged": false, "classification": "true-negative", "decision": "allow"},
        {"id": "convincing-false-source", "intent": "adversarial", "flagged": false, "classification": "false-negative", "decision": "allow"},
        {"id": "inference-labelled-as-observation", "intent": "adversarial", "flagged": false, "classification": "false-negative", "decision": "allow"},
        {"id": "unsupported-high-confidence", "intent": "adversarial", "flagged": true, "classification": "true-positive", "decision": "blocked"},
        {"id": "overdue-recheck", "intent": "adversarial", "flagged": true, "classification": "true-positive", "decision": "blocked"},
        {"id": "verified-primary-source", "intent": "benign", "flagged": true, "classification": "false-positive", "decision": "blocked"},
        {"id": "bounded-hypothesis", "intent": "benign", "flagged": false, "classification": "true-negative", "decision": "allow"}
      ]
    }
  },
  "finding": {
    "result": "block-on-warning blocks 4 of 8 cases: 2 intended adversarial cases and 2 benign controls.",
    "implication": "A naive gate converts the existing warning false positives into blocked work while still allowing 2 adversarial cases, so warning severity needs a narrower policy before merge gating."
  }
}
